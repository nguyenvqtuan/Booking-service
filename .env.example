# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=3000
TZ=UTC
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=booking
DB_PASSWORD=booking
DB_NAME=booking
DB_SSL=false
DB_LOGGING=false

# Auth (BS-15) — generate a secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MIN=30
BCRYPT_ROUNDS=10
COOKIE_SECURE=false
APP_WEB_URL=http://localhost:5173

# Redis for BullMQ (BS-27)
REDIS_URL=redis://localhost:6379
# Run the reminder dispatch cron in this API instance
REMINDER_CRON_ENABLED=true
# Rate limit of public routes, per IP and route
PUBLIC_RATE_LIMIT_PER_MIN=60
# Number of reverse proxies in front of the API (so the limit sees real client IPs)
TRUST_PROXY_HOPS=0
# fake = log messages only; live = real ZNS/SMS providers (BS-29/BS-30)
MESSAGE_PROVIDER=fake

# Zalo ZNS (BS-29) — required when MESSAGE_PROVIDER=live (see Jira BS-49..BS-52)
# ZNS_APP_ID=
# ZNS_APP_SECRET=
# ZNS_REFRESH_TOKEN=       # bootstrap only; rotated tokens are stored in provider_tokens
# ZNS_TEMPLATE_ID_VI=
# ZNS_TEMPLATE_ID_EN=      # optional, falls back to the Vietnamese template

# SMS brandname via eSMS (BS-30) — required when MESSAGE_PROVIDER=live (see Jira BS-54..BS-57)
# SMS_API_KEY=
# SMS_SECRET_KEY=
# SMS_BRANDNAME=
# SMS_TEMPLATE_VI=         # must match the carrier-approved template; {salon} {service} {time} {date} {name}
# SMS_TEMPLATE_EN=
# SMS_SANDBOX=true

# ---------- WEB (apps/web) ----------
VITE_API_URL=http://localhost:3000
