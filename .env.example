# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=3000
TZ=UTC
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=booking
DB_PASSWORD=booking
DB_NAME=booking
DB_SSL=false
DB_LOGGING=false

# Auth (BS-15) — generate a secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MIN=30
BCRYPT_ROUNDS=10
COOKIE_SECURE=false
APP_WEB_URL=http://localhost:5173

# Redis for BullMQ (BS-27)
REDIS_URL=redis://localhost:6379
# Run the reminder dispatch cron in this API instance
REMINDER_CRON_ENABLED=true
# fake = log messages only; live = real ZNS/SMS providers (BS-29/BS-30)
MESSAGE_PROVIDER=fake

# ---------- WEB (apps/web) ----------
VITE_API_URL=http://localhost:3000
